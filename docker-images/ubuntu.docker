FROM ubuntu

RUN apt update
RUN apt install -y git make cmake dotnet-sdk-10.0 gfortran gcobol rust-all golang ghc nasm python3 gnu-which ldc zig wget
RUN apt install -y gnat-$(gcc -dumpversion)

WORKDIR /compiled-languages-interoperability
COPY include include
COPY src src
COPY scripts scripts
COPY Makefile .

RUN ["make"]
CMD ["./a.out"]
